#compdef zap
_zap() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -s \
    '--dry-run[Plan without builds or system changes]' \
    '--devel[Include VCS rebuilds during updates or upgrade]' \
    '--recursive[Remove unneeded dependencies]' \
    '--nosave[Discard backup configuration during removal]' \
    '--aur[Scope requested packages to AUR]' \
    '--repo[Scope requested packages to repositories]' \
    '--needed[Skip current installed packages]' \
    '--asdeps[Mark requested packages as dependencies]' \
    '--asexplicit[Mark requested packages as explicit]' \
    '--sandbox[Isolate every makepkg phase (default)]' \
    '--no-sandbox[Build with the invoking user permissions]' \
    '--rebuildtree[Rebuild installed foreign dependencies]' \
    '--cleanafter[Remove untracked outputs after installation]' \
    '--quiet[Print names only]' \
    '--searchby[AUR search field]:field:(name name-desc maintainer provides depends makedepends checkdepends optdepends)' \
    '--sortby[AUR result order]:field:(votes popularity name modified)' \
    '--help[Show help]' \
    '--version[Show version]' \
    '1:command:(search select info localinfo install install-files build build-local install-local get pkgbuild upgrade updates list foreign local-search files owns check reason remove orphans autoremove clean stats news help version)' \
    '*:target:->targets'
  if [[ $state == targets ]]; then
    case $line[1] in
      remove|-R|-Rns|reason|-D|localinfo|-Qi|files|-Ql|check|-Qk|list|-Q|foreign|-Qm)
        local -a packages
        packages=("${(@f)$(zap list --quiet 2>/dev/null)}")
        _describe 'installed package' packages ;;
      build-local|install-local|-B|-Bi) _files -/ ;;
      install-files|-U|owns|-Qo) _files ;;
    esac
  fi
}
_zap "$@"
